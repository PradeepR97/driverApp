# Copy to `.env` for local development (`.env` is gitignored — never commit secrets).
# Must use EXPO_PUBLIC_ prefix for client-side access in Expo.
EXPO_PUBLIC_API_URL=https://your-api-host.example.com/api/v1

# Set to true to log every API request/response in release builds (dev logs by default).
# EXPO_PUBLIC_API_DEBUG=true

# Optional: POST path for language sync after OTP (default /users/language).
# EXPO_PUBLIC_USERS_LANGUAGE_PATH=/users/language

# Optional: GET app state after OTP for routing (default /app/state).
# EXPO_PUBLIC_APP_STATE_PATH=/app/state

# Optional: GET meta dropdowns (default /meta/options).
# EXPO_PUBLIC_META_OPTIONS_PATH=/meta/options

# --- Direct S3 upload from the app (credentials are visible in the bundle — use scoped IAM only) ---
# Paste your keys only in `.env` locally. Rotate any key that was ever exposed in git.
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=
EXPO_PUBLIC_S3_BUCKET_NAME=your-bucket-name
EXPO_PUBLIC_S3_UPLOAD_PREFIX=driver
# EXPO_PUBLIC_S3_PUBLIC_BASE_URL=https://your-cdn.example.com
# EXPO_PUBLIC_S3_OBJECT_ACL=public-read

# Optional onboarding path overrides (defaults /onboarding/owner|vehicle|driver).
# EXPO_PUBLIC_ONBOARDING_OWNER_PATH=/onboarding/owner
